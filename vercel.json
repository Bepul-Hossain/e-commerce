{
  "framework": null,
  "installCommand": "npm install && npm --prefix client/ecommerce install && npm --prefix client/super-admin install",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/super-admin", "destination": "/super-admin/index.html" },
    { "source": "/super-admin/(.*)", "destination": "/super-admin/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
